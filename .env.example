# open-recs-local — environment template
# Copy to .env and fill in. APP_MODE switches the whole app between
# single-user local and multi-user hosted; do not mix.

# ---- Core -----------------------------------------------------------------

# local | hosted
APP_MODE=local

# Postgres (with pgvector) — via docker-compose this is the internal hostname.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/openrecs

# ---- Hosted-mode only (required when APP_MODE=hosted) ---------------------

# Minimum 32 chars. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public URL the app is served from.
BETTER_AUTH_URL=http://localhost:3000

# Signed-file-URL HMAC secret. Required in hosted mode (min 32 chars).
# Local mode falls back to a built-in dev default if unset.
FILE_TOKEN_SECRET=

# Encryption key for provider API keys stored in the database (AES-256-GCM).
# Local mode falls back to a dev default; hosted mode REQUIRES a real 32+ char value.
PROVIDER_SECRET_KEY=

# ---- Email provider (used for password reset + magic link) ----------------

# console | resend
# `console` writes outgoing emails to stdout with copy-pasteable URLs —
# fine for local dev or evaluation. Hosted instances should use `resend`.
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Sender address Resend should put on outgoing messages.
RESEND_FROM=

# ---- LLM provider ---------------------------------------------------------

# openai-compatible | anthropic | mistral | fake
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
# For openai-compatible providers (Ollama, LM Studio, vLLM, OpenAI).
LLM_BASE_URL=
# Per-request timeout (ms) for the openai-compatible LLM. Guards against a
# stuck local server locking a worker. Defaults to 120000 (120s); raise for
# slow large models.
LLM_TIMEOUT_MS=

# ---- Streaming-chat provider (optional override) --------------------------

# Dedicated config for the /chat streaming surface. Any CHAT_* var that is
# unset falls back to the matching LLM_* value, so single-model deployments
# leave this section blank. Set these only when you want extract and chat to
# use different models (e.g. a heavy structured-output model for extract +
# a small streaming model for chat).
CHAT_PROVIDER=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=

# ---- Embedding provider ---------------------------------------------------

# openai-compatible | voyage | fake
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Must match schema vector(N). Default 768.
EMBEDDING_DIMENSIONS=768

# ---- OCR provider ---------------------------------------------------------

# mistral | docling | firecrawl | tesseract-pdf | fake
OCR_PROVIDER=fake
OCR_API_KEY=
# docling: HTTP endpoint of the docling sidecar.
DOCLING_URL=http://docling:5001

# ---- Storage provider -----------------------------------------------------

# fake | fs | s3
# `fake` is in-process (good for tests, no cross-process visibility).
# `fs` persists to disk so the dev server and worker share files.
# `s3` is planned.
STORAGE_PROVIDER=fs
# fs: filesystem path the app + worker both mount. Defaults to ./.data/uploads
# locally; in compose this is /data/uploads on the shared volume.
STORAGE_FS_PATH=./.data/uploads
# s3 / MinIO.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# CRUX runtime observation (optional, disabled unless all four are set)
# Metadata only: workflow/provider/operation and optional model/token metadata.
# Prompt text, model output, reasoning and source-document content are not emitted.
CRUX_INGEST_URL=
CRUX_INGEST_TOKEN=
CRUX_SYSTEM_VERSION_REF=
CRUX_PRODUCER_ID=
